{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ai-glossary",
      "destination": "/learning-center#ai-glossary",
      "permanent": true
    },
    {
      "source": "/ai-glossary.html",
      "destination": "/learning-center#ai-glossary",
      "permanent": true
    }
  ]
}
